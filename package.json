{
  "name": "pi-perf",
  "version": "0.2.0",
  "description": "Low-noise Pi process diagnostics and opt-in continuous profiling with Grafana Pyroscope.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/slim-bean/pi-perf.git" },
  "homepage": "https://github.com/slim-bean/pi-perf#readme",
  "bugs": { "url": "https://github.com/slim-bean/pi-perf/issues" },
  "keywords": ["pi-package", "profiling", "pyroscope", "diagnostics"],
  "files": ["src", "README.md", "LICENSE"],
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:pi": "node --import tsx scripts/smoke-pi.ts"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "peerDependenciesMeta": { "@earendil-works/pi-coding-agent": { "optional": true } },
  "dependencies": { "@pyroscope/nodejs": "0.6.5" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^26.0.0",
    "pprof-format": "^2.2.1",
    "tsx": "^4.20.0",
    "typescript": "^7.0.0"
  },
  "engines": { "node": ">=22.19.0" }
}
